# Dùng SQLite cho demo nhanh hoặc mở dòng MySQL sau khi docker compose up -d.
# DATABASE_URL=mysql+pymysql://career:career_local_only@127.0.0.1:3307/careerconnect?charset=utf8mb4
# QDRANT_URL=http://127.0.0.1:6335
JWT_SECRET=
OPENAI_API_KEY=
AI_BACKEND=local
# Python environment containing LangGraph, LangChain OpenAI and the cached BGE reranker.
# Enables the original graph with local evidence and answer adapters.
# RAG_LEGACY_PYTHON=data/runtime/rag-venv/Scripts/python.exe
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REPORT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
AI_DAILY_CALLS=100
AI_DAILY_MOCKS=5
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
